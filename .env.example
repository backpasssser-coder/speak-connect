# Firebase 프로젝트: sesac-teamproject
# 값 출처: Firebase Console > 프로젝트 설정 > 일반 (Apple 앱: com.sesac.speakconnect)
# 실제 값은 .env 파일에 채워서 사용하세요 (.env는 git에 커밋되지 않습니다)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sesac-teamproject.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sesac-teamproject
VITE_FIREBASE_STORAGE_BUCKET=sesac-teamproject.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=937867817479
VITE_FIREBASE_APP_ID=
